# Backend Supabase & Server Configuration
# Copy this file to .env in the backend folder and fill in your actual credentials.

SUPABASE_URL=https://your-project-id.supabase.co

# Use your Supabase Service Role Key for server-side administrative access (bypasses RLS safety on backend)
# OR use your Anon Key if using PostgREST RLS token passing.
SUPABASE_KEY=your-actual-supabase-key-here

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app-name.netlify.app
